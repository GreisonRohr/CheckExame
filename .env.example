# Chave da API da Anthropic (extrator Claude)
ANTHROPIC_API_KEY=
# Modelo e nível de esforço (low | medium | high | xhigh | max)
CHECKEXAME_CLAUDE_MODEL=claude-opus-5-5
CHECKEXAME_CLAUDE_EFFORT=high
# Limiares de score para o mapeamento automático de exames (0-100)
CHECKEXAME_SCORE_OK=90
CHECKEXAME_SCORE_REVISAR=70
# Integração com o LIS: mock | http
CHECKEXAME_LIS_ADAPTER=mock
CHECKEXAME_LIS_URL=
CHECKEXAME_LIS_TOKEN=

# --- Shift (use CHECKEXAME_LIS_ADAPTER=shift) ---
# Endereço do web service. Vazio = modo arquivo (gera o XML em data/os_geradas/ sem enviar)
CHECKEXAME_SHIFT_URL=
# integracao = ImportaPedidoSinc(IdIntegracao, Usuario, Senha, Pedidos) | hospital = RecebePedido(idHospital, pedidoLab)
CHECKEXAME_SHIFT_MODELO=integracao
CHECKEXAME_SHIFT_ID_INTEGRACAO=
CHECKEXAME_SHIFT_USUARIO=
CHECKEXAME_SHIFT_SENHA=
# Namespace, método e SOAPAction do WSDL (confirmar com a Shift)
CHECKEXAME_SHIFT_NAMESPACE=http://tempuri.org
CHECKEXAME_SHIFT_METODO=
CHECKEXAME_SHIFT_SOAP_ACTION=
# Código do posto/setor de coleta e convênio usado quando o lido não é reconhecido
CHECKEXAME_SHIFT_POSTO=
CHECKEXAME_SHIFT_CONVENIO_PADRAO=
CHECKEXAME_SHIFT_PREFIXO=CKX
